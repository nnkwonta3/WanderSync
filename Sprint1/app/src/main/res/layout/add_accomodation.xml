<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/popup_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Accommodation"
        android:textSize="20sp"
        android:layout_marginBottom="60px"
        android:layout_gravity="center"/>

    <EditText
        android:id="@+id/input_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60px"
        android:hint="Location"/>

    <EditText
        android:id="@+id/input_check_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Check In Date"
        android:layout_marginBottom="60px"
        android:focusable="false"/>

    <EditText
        android:id="@+id/input_check_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Check Out Date"
        android:layout_marginBottom="60px"
        android:focusable="false"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Number Of Rooms:"
        android:textSize="20sp"
        android:layout_marginBottom="60px"
        />

    <Spinner
        android:id="@+id/spinner_num_rooms"
        android:layout_width="match_parent"
        android:layout_marginBottom="60px"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Room Type:"
        android:textSize="20sp"
        android:layout_marginBottom="60px"
        />

    <Spinner
        android:id="@+id/spinner_room_type"
        android:layout_width="match_parent"
        android:layout_marginBottom="60px"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60px"
        android:text="Submit"/>
</LinearLayout>
