<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f0f0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/welcome_to_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logistics"
            android:textSize="47sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="15dp"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/allotted_v_planned"
            android:layout_width="246dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/create_account_button"
            android:elevation="4dp"
            android:text="Allotted V. Planned Graph"
            android:textColor="#fff" />

        <!-- Add a container for the graph -->
        <FrameLayout
            android:id="@+id/graph_container"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contributors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contributors"
            android:textSize="35sp"
            android:textColor="#000"
            android:layout_marginTop="25dp"/>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_weight="1"
            android:padding="16dp">

        <LinearLayout
            android:id="@+id/destinations_list_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
        </ScrollView>



        <!-- Add other content here -->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="start|end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/notes_button"
            android:layout_width="75dp"
            android:layout_height="73dp"
            android:layout_marginEnd="250dp"
            android:background="@drawable/create_account_button"
            android:text="Notes"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_gravity="start" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/share_user_btn"
            android:layout_width="75dp"
            android:layout_height="73dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/login_button"
            android:text="Share"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_gravity="end" />

    </LinearLayout>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:visibility="visible"
        app:itemBackground="@color/black"
        app:menu="@menu/menu_navigation" />

</LinearLayout>
